<mujoco model="go2 furnished home">
  <include file="go2.xml"/>

  <statistic center="4 0 0.6" extent="8.5"/>

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.35 0.35 0.35" specular="0.15 0.15 0.15"/>
    <rgba haze="0.70 0.76 0.82 1"/>
    <global azimuth="-125" elevation="-28" offwidth="1280" offheight="900"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.78 0.86 0.94" rgb2="0.30 0.38 0.48" width="512" height="3072"/>
    <texture type="2d" name="home_floor_tex" builtin="checker" mark="edge"
             rgb1="0.72 0.65 0.54" rgb2="0.64 0.56 0.45" markrgb="0.45 0.38 0.30"
             width="400" height="400"/>
    <material name="home_floor" texture="home_floor_tex" texuniform="true" texrepeat="14 12" reflectance="0.04"/>
    <material name="wall" rgba="0.91 0.90 0.86 1"/>
    <material name="art_blue" rgba="0.18 0.34 0.58 1"/>
    <material name="art_ochre" rgba="0.72 0.43 0.15 1"/>
    <material name="art_green" rgba="0.20 0.50 0.34 1"/>
    <material name="art_red" rgba="0.64 0.23 0.20 1"/>
    <material name="wood" rgba="0.42 0.24 0.12 1"/>
    <material name="light_wood" rgba="0.68 0.48 0.27 1"/>
    <material name="sofa" rgba="0.18 0.36 0.52 1"/>
    <material name="fabric" rgba="0.72 0.68 0.62 1"/>
    <material name="home_metal" rgba="0.36 0.39 0.43 1"/>
    <material name="appliance" rgba="0.82 0.85 0.88 1"/>
    <material name="plant" rgba="0.12 0.48 0.19 1"/>
    <material name="cardboard" rgba="0.58 0.39 0.20 1"/>
    <material name="rug" rgba="0.46 0.18 0.16 1"/>
  </asset>

  <worldbody>
    <light pos="3 -1 6" dir="0 0 -1" directional="true" diffuse="0.85 0.82 0.76"/>
    <light pos="8 3 4" dir="0 0 -1" directional="true" diffuse="0.55 0.60 0.68"/>

    <!-- 14 m x 12 m floor and outer walls. All collision geometry is group 1
         so the local elevation mapper sees imported household geometry. -->
    <geom name="floor" type="plane" group="1" size="0 0 0.05"
          material="home_floor" friction="1.0 0.01 0.001"/>
    <geom name="wall_west" type="box" group="1" pos="-3 0 0.75" size="0.09 6.0 0.75" material="wall"/>
    <geom name="wall_east" type="box" group="1" pos="11 0 0.75" size="0.09 6.0 0.75" material="wall"/>
    <geom name="wall_south" type="box" group="1" pos="4 -6 0.75" size="7.0 0.09 0.75" material="wall"/>
    <geom name="wall_north" type="box" group="1" pos="4 6 0.75" size="7.0 0.09 0.75" material="wall"/>

    <!-- Main partition with a 2 m doorway centered on y=0. -->
    <geom name="partition_left_south" type="box" group="1" pos="3.5 -3.5 0.75" size="0.08 2.5 0.75" material="wall"/>
    <geom name="partition_left_north" type="box" group="1" pos="3.5 3.5 0.75" size="0.08 2.5 0.75" material="wall"/>
    <!-- Bedroom partition with a 1.2 m door opening. -->
    <geom name="partition_bed_west" type="box" group="1" pos="4.35 1.55 0.75" size="0.85 0.08 0.75" material="wall"/>
    <geom name="partition_bed_east" type="box" group="1" pos="8.60 1.55 0.75" size="2.40 0.08 0.75" material="wall"/>

    <!-- Unique, visual-only wall art supplies the non-repeating corners a
         real furnished home has.  Group 2 and disabled contacts keep both
         LiDAR geometry and physical passage widths exactly unchanged. -->
    <geom name="vslam_art_e1" type="box" group="2" pos="10.905 -4.10 0.82" size="0.012 0.34 0.26" material="art_blue" contype="0" conaffinity="0"/>
    <geom name="vslam_art_e2" type="box" group="2" pos="10.905 -2.65 0.68" size="0.012 0.22 0.38" material="art_ochre" contype="0" conaffinity="0"/>
    <geom name="vslam_art_e3" type="box" group="2" pos="10.905 -1.15 0.90" size="0.012 0.40 0.20" material="art_green" contype="0" conaffinity="0"/>
    <geom name="vslam_art_e4" type="box" group="2" pos="10.905 0.45 0.72" size="0.012 0.26 0.32" material="art_red" contype="0" conaffinity="0"/>
    <geom name="vslam_art_b1" type="box" group="2" pos="4.55 1.455 0.78" size="0.30 0.012 0.24" material="art_red" contype="0" conaffinity="0"/>
    <geom name="vslam_art_b2" type="box" group="2" pos="7.20 1.455 0.67" size="0.42 0.012 0.32" material="art_blue" contype="0" conaffinity="0"/>
    <geom name="vslam_art_b3" type="box" group="2" pos="9.35 1.455 0.88" size="0.24 0.012 0.20" material="art_ochre" contype="0" conaffinity="0"/>

    <!-- Living room: rug, sofa, armchair, coffee table and TV unit. -->
    <geom name="living_rug" type="box" group="1" pos="0.3 2.35 0.012" size="1.75 1.35 0.012" material="rug" contype="0" conaffinity="0"/>
    <geom name="sofa_base" type="box" group="1" pos="0.2 4.65 0.22" size="1.45 0.42 0.22" material="sofa"/>
    <geom name="sofa_back" type="box" group="1" pos="0.2 5.02 0.63" size="1.45 0.12 0.48" material="sofa"/>
    <geom name="sofa_arm_l" type="box" group="1" pos="-1.18 4.65 0.43" size="0.12 0.42 0.43" material="sofa"/>
    <geom name="sofa_arm_r" type="box" group="1" pos="1.58 4.65 0.43" size="0.12 0.42 0.43" material="sofa"/>
    <geom name="coffee_table_top" type="box" group="1" pos="0.25 2.55 0.34" size="0.75 0.48 0.055" material="light_wood"/>
    <geom name="coffee_leg_1" type="cylinder" group="1" pos="-0.35 2.22 0.17" size="0.045 0.17" material="home_metal"/>
    <geom name="coffee_leg_2" type="cylinder" group="1" pos="0.85 2.22 0.17" size="0.045 0.17" material="home_metal"/>
    <geom name="coffee_leg_3" type="cylinder" group="1" pos="-0.35 2.88 0.17" size="0.045 0.17" material="home_metal"/>
    <geom name="coffee_leg_4" type="cylinder" group="1" pos="0.85 2.88 0.17" size="0.045 0.17" material="home_metal"/>
    <geom name="armchair" type="box" group="1" pos="2.35 3.35 0.33" size="0.45 0.52 0.33" material="fabric"/>
    <geom name="tv_console" type="box" group="1" pos="0.2 0.60 0.26" size="1.25 0.26 0.26" material="wood"/>
    <geom name="television" type="box" group="1" pos="0.2 0.62 0.93" size="0.78 0.055 0.46" material="home_metal"/>

    <!-- Small daily objects in the living room. -->
    <geom name="book_on_floor" type="box" group="1" pos="-1.45 1.75 0.035" size="0.18 0.12 0.035" rgba="0.15 0.28 0.70 1"/>
    <geom name="toy_block_1" type="box" group="1" pos="1.55 1.65 0.055" size="0.07 0.07 0.055" rgba="0.90 0.25 0.16 1"/>
    <geom name="toy_block_2" type="box" group="1" pos="1.78 1.82 0.07" size="0.08 0.08 0.07" rgba="0.95 0.72 0.12 1"/>
    <geom name="robot_vacuum" type="cylinder" group="1" pos="-1.55 3.25 0.055" size="0.18 0.055" material="home_metal"/>
    <geom name="plant_pot" type="cylinder" group="1" pos="2.65 5.05 0.26" size="0.24 0.26" material="cardboard"/>
    <geom name="plant_stem" type="cylinder" group="1" pos="2.65 5.05 0.75" size="0.045 0.49" material="plant" contype="0" conaffinity="0"/>
    <geom name="plant_crown" type="sphere" group="1" pos="2.65 5.05 1.12" size="0.34" material="plant" contype="0" conaffinity="0"/>

    <!-- Entry / central hallway objects. -->
    <geom name="shoe_cabinet" type="box" group="1" pos="-2.55 -1.85 0.48" size="0.28 0.90 0.48" material="light_wood"/>
    <geom name="shoe_left" type="capsule" group="1" pos="-1.45 -1.35 0.055" size="0.055 0.14" quat="0.7071 0 0.7071 0" rgba="0.12 0.12 0.13 1"/>
    <geom name="shoe_right" type="capsule" group="1" pos="-1.15 -1.20 0.055" size="0.055 0.14" quat="0.7071 0 0.7071 0" rgba="0.12 0.12 0.13 1"/>
    <geom name="parcel_large" type="box" group="1" pos="2.55 -0.95 0.28" size="0.36 0.30 0.28" material="cardboard"/>
    <geom name="parcel_small" type="box" group="1" pos="2.12 -1.12 0.17" size="0.24 0.22 0.17" material="cardboard"/>
    <geom name="umbrella_stand" type="cylinder" group="1" pos="-2.45 0.55 0.34" size="0.18 0.34" material="home_metal"/>

    <!-- Dining area. -->
    <geom name="dining_table_top" type="box" group="1" pos="5.70 -3.20 0.72" size="1.10 0.72 0.07" material="light_wood"/>
    <geom name="dining_leg_1" type="cylinder" group="1" pos="4.82 -3.72 0.35" size="0.055 0.35" material="wood"/>
    <geom name="dining_leg_2" type="cylinder" group="1" pos="6.58 -3.72 0.35" size="0.055 0.35" material="wood"/>
    <geom name="dining_leg_3" type="cylinder" group="1" pos="4.82 -2.68 0.35" size="0.055 0.35" material="wood"/>
    <geom name="dining_leg_4" type="cylinder" group="1" pos="6.58 -2.68 0.35" size="0.055 0.35" material="wood"/>
    <geom name="chair_south_1" type="box" group="1" pos="5.05 -4.28 0.32" size="0.30 0.30 0.32" material="fabric"/>
    <geom name="chair_south_2" type="box" group="1" pos="6.35 -4.28 0.32" size="0.30 0.30 0.32" material="fabric"/>
    <geom name="chair_north_1" type="box" group="1" pos="5.05 -2.12 0.32" size="0.30 0.30 0.32" material="fabric"/>
    <geom name="chair_north_2" type="box" group="1" pos="6.35 -2.12 0.32" size="0.30 0.30 0.32" material="fabric"/>
    <geom name="pet_bowl" type="cylinder" group="1" pos="4.12 -4.85 0.055" size="0.15 0.055" rgba="0.18 0.55 0.72 1"/>

    <!-- Kitchen: counters, island, refrigerator, bin and stool. -->
    <geom name="kitchen_counter_east" type="box" group="1" pos="10.18 -2.50 0.48" size="0.65 2.55 0.48" material="appliance"/>
    <geom name="kitchen_counter_south" type="box" group="1" pos="8.20 -5.28 0.48" size="2.62 0.62 0.48" material="appliance"/>
    <geom name="kitchen_island" type="box" group="1" pos="8.15 -2.80 0.50" size="0.78 1.10 0.50" material="light_wood"/>
    <geom name="fridge" type="box" group="1" pos="9.85 -4.55 1.00" size="0.52 0.48 1.00" material="appliance"/>
    <geom name="trash_bin" type="cylinder" group="1" pos="9.20 -1.05 0.36" size="0.23 0.36" material="home_metal"/>
    <geom name="kitchen_stool" type="cylinder" group="1" pos="7.10 -2.80 0.38" size="0.28 0.38" material="wood"/>

    <!-- Bedroom: bed, nightstands, wardrobe, laundry basket and suitcase. -->
    <geom name="bed_base" type="box" group="1" pos="7.15 4.15 0.27" size="1.18 1.55 0.27" material="wood"/>
    <geom name="mattress" type="box" group="1" pos="7.15 4.15 0.55" size="1.12 1.48 0.18" material="fabric"/>
    <geom name="pillow_left" type="box" group="1" pos="6.62 5.18 0.78" size="0.38 0.28 0.10" material="wall" contype="0" conaffinity="0"/>
    <geom name="pillow_right" type="box" group="1" pos="7.68 5.18 0.78" size="0.38 0.28 0.10" material="wall" contype="0" conaffinity="0"/>
    <geom name="nightstand_left" type="box" group="1" pos="5.55 4.92 0.34" size="0.34 0.38 0.34" material="light_wood"/>
    <geom name="nightstand_right" type="box" group="1" pos="8.75 4.92 0.34" size="0.34 0.38 0.34" material="light_wood"/>
    <geom name="wardrobe" type="box" group="1" pos="10.15 3.70 1.05" size="0.62 1.28 1.05" material="wood"/>
    <geom name="laundry_basket" type="cylinder" group="1" pos="9.35 5.22 0.42" size="0.31 0.42" material="fabric"/>
    <geom name="suitcase" type="box" group="1" pos="4.42 3.20 0.34" size="0.24 0.48 0.34" material="home_metal"/>

    <!-- Bathroom / utility corner. -->
    <geom name="washing_machine" type="box" group="1" pos="-2.20 -4.95 0.48" size="0.48 0.48 0.48" material="appliance"/>
    <geom name="storage_shelf" type="box" group="1" pos="-0.65 -5.52 0.85" size="0.80 0.32 0.85" material="home_metal"/>
    <geom name="bucket" type="cylinder" group="1" pos="0.75 -4.75 0.22" size="0.20 0.22" rgba="0.18 0.48 0.72 1"/>
    <geom name="mop_handle" type="cylinder" group="1" pos="0.95 -5.30 0.78" size="0.025 0.78" quat="0.98 0.20 0 0" material="home_metal" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
